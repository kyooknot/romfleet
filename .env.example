# RomFleet configuration — copy to backend/.env and fill in.
#
# Every key below maps to a field in backend/app/core/config.py (pydantic-settings,
# case-insensitive). Anything NOT listed there is ignored silently, so if a setting
# appears to do nothing, check the field name in config.py first.
#
# Every value has a default, so the app STARTS with an empty .env — but the RA gate
# and every scraper are inert without credentials. Nothing warns you; the library
# simply never matches anything.

# ── RetroAchievements — REQUIRED ──────────────────────────────────────────────
# The whole library is RA-gated: with no key, nothing is ever matched or sourced.
# Key: https://retroachievements.org → Settings → Web API Key
RA_USERNAME=
RA_API_KEY=
RA_API_BASE=https://retroachievements.org/API
RA_MEDIA_BASE=https://media.retroachievements.org

# ── Datastores — REQUIRED (defaults assume all three on localhost) ────────────
DATABASE_URL=postgresql+psycopg2://romfleet:romfleet@127.0.0.1:5432/romfleet
ES_URL=http://127.0.0.1:9200
ES_INDEX_GAMES=ra_games
ES_INDEX_ROMS=local_roms
REDIS_URL=redis://127.0.0.1:6379/0

# ── Paths ─────────────────────────────────────────────────────────────────────
# SRC_ROMS_PATH  read-only mount of the collection you are ingesting FROM
# CANONICAL_PATH read-write library RomFleet builds and serves
# LBDB_PATH      LaunchBox GamesDB SQLite metadata file (download separately)
# CONFIG_PATH / DATS_PATH default to the repo's own config/ and dats/ dirs.
SRC_ROMS_PATH=/mnt/src/roms
CANONICAL_PATH=/mnt/romfleet
LBDB_PATH=/var/lib/romfleet/LaunchBox.Metadata.db
# CONFIG_PATH=
# DATS_PATH=

# ── Optional metadata / media scrapers ────────────────────────────────────────
# All optional. Each one left blank simply disables that source.
TGDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
EMU_USER=
EMU_PASS=
SS_DEV_ID=
SS_DEV_PASSWORD=
SS_SOFTNAME=RomFleet
SS_USER=
SS_PASS=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── NOT set here ──────────────────────────────────────────────────────────────
# Discord notification webhooks and per-event routing live in the DATABASE
# (Settings → Notifications, or PATCH /api/settings), not in this file — so they
# can be changed without a restart. See docs/notifications.md.
